<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- FCM push (Build #24): Android 13+ needs this at runtime — the
         Settings toggles request it when first turned on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- In-app updater (Build #25): the system installer needs this
         declared before canRequestPackageInstalls() can ever return
         true; the user still grants it per-app on the unknown-sources
         settings screen (the dialog sends them there). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM push (Build #24): receives data-only messages and builds
             the notification itself (StarBrookMessagingService). The
             MESSAGING_EVENT intent-filter is what FCM uses to deliver.
             Not exported: only Firebase + the app talk to it. -->
        <service
            android:name=".data.push.StarBrookMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- In-app updater (Build #25): hands the downloaded APK to the
             system installer. ${applicationId} resolves per build type
             (debug carries the .debug suffix); the file lives in
             app-private cache storage (res/xml/file_paths.xml). Not
             exported: only the installer reads it, via the granted URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Fallbacks if a message ever arrives without a channel id in
             its data (the server always sets one — see _shared/fcm.ts). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="starbrook_breaking" />
    </application>

</manifest>
